---
import type { Material, Scope_Name } from "@cs-first-aid/bibkit/types/data";
import * as bib from "@cs-first-aid/bibkit/bib";
export interface Props {
  materials: Material[],
  reference_ranges?: bib.Reference_Ranges,
  scope_name?: Scope_Name,
}
const { materials, reference_ranges, scope_name = [], } = Astro.props
const serialized_scope_name = JSON.stringify(scope_name)
const range = reference_ranges?.[serialized_scope_name]
if (scope_name.length > 0 && reference_ranges === undefined) { throw new Error(`Missing ranges for reference scope: ${serialized_scope_name}`) }
if (reference_ranges !== undefined && range === undefined) { throw new Error(`Unknown reference scope: ${serialized_scope_name}`) }
if (range !== undefined && range[1] - range[0] !== materials.length) { throw new Error(`Reference scope length does not match its materials: ${serialized_scope_name}`) }
const printed_bib = range === undefined
  ? bib.print_bibliography(materials, { language: Astro.locals.starlightRoute.lang })
  : bib.print_bibliography_segment(materials, { language: Astro.locals.starlightRoute.lang, start_number: range[0] + 1 })
---

<div class="References" data-scope_name={serialized_scope_name} set:html={printed_bib}></div>
