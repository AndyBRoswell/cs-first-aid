---
import type { Material, Scope_Name } from "@cs-first-aid/bibkit/types/data";
import * as bib from "@cs-first-aid/bibkit/bib";
export interface Props {
  mangled_references: bib.Mangled_References,
  scope_name?: Scope_Name,
}
const { mangled_references, scope_name = [], } = Astro.props
const serialized_scope_name = JSON.stringify(scope_name)
const [ start, end ] = mangled_references.range[serialized_scope_name]!
const material_segment = mangled_references.flattened.data.slice(start, end) as Material[]
const printed_bib = bib.print_bibliography_segment(material_segment, { language: Astro.locals.starlightRoute.lang, start_number: start + 1 })
---

<div class="References" data-scope_name={serialized_scope_name} data-material_segment={JSON.stringify(material_segment)} set:html={printed_bib}></div>
