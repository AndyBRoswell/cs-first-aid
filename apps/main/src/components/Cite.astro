---
import type { Citation_Item, Scoped_References } from "@cs-first-aid/bibkit/types/data"
import * as bib from "@cs-first-aid/bibkit/bib"
export interface Props {
  references: Scoped_References
  reference_ranges?: bib.Reference_Ranges
  cite_items: Citation_Item[]
}
const { references, reference_ranges, cite_items, } = Astro.props
---
<span class="Cite" set:html={bib.cite(references, cite_items, reference_ranges)}></span>

<style>
  .Cite {
    display: inline;
    margin-left: 0.25rem;
    margin-right: 0.25rem;
  }
</style>
