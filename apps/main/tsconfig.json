{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "astro",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "@package.json": ["./package.json"],
      "@tests/*": ["./tests/*"]
    }
  },
  "references": [
    { "path": "../../packages/bibkit" },
    { "path": "../../packages/util" },
  ]
}
